<?xml version="1.0" encoding="UTF-8"?>
<gexf xmlns="http://gexf.net/1.3" version="1.3">
  <graph defaultedgetype="directed">
    <attributes class="node">
      <attribute id="type" title="type" type="string"/>
    </attributes>
    <nodes>
      <node id="p1" label="أحمد المكي">
        <attvalues><attvalue for="type" value="person"/></attvalues>
      </node>
      <node id="c1" label="شركة المثل القابضة">
        <attvalues><attvalue for="type" value="company"/></attvalues>
      </node>
      <node id="d1" label="holdings.example">
        <attvalues><attvalue for="type" value="domain"/></attvalues>
      </node>
      <node id="ip1" label="192.0.2.7">
        <attvalues><attvalue for="type" value="ipv4"/></attvalues>
      </node>
    </nodes>
    <edges>
      <edge id="p1-owns-c1" source="p1" target="c1" label="ownership"/>
      <edge id="d1-resolves-ip1" source="d1" target="ip1" label="resolves_to"/>
    </edges>
  </graph>
</gexf>
