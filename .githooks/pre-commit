#!/bin/sh
# Fast pre-check (GR-01). Full check runs in commit-msg and again in CI.
root="$(git rev-parse --show-toplevel)"
staged="$(git diff --cached --name-only)"
case "$staged" in *"docs/STATUS.md"*) ;; *) echo "GR-01: stage docs/STATUS.md with your change (see GOVERNANCE.md)."; exit 1;; esac
case "$staged" in *"docs/WORKLOG.md"*) ;; *) echo "GR-01: add a docs/WORKLOG.md entry in this commit (see GOVERNANCE.md)."; exit 1;; esac
# GR-12: never commit env files
if echo "$staged" | grep -Eq '(^|/)\.env($|\.)' && ! echo "$staged" | grep -Eq '\.env\.example$'; then echo "GR-12: .env files must not be committed."; exit 1; fi
# P0-022: lint and format staged files only (lint-staged re-stages formatted files).
if [ -x "$root/node_modules/.bin/lint-staged" ]; then
  "$root/node_modules/.bin/lint-staged" --diff-filter=ACM || exit 1  # renames (R) are left untouched so moves stay pure
else
  echo "pre-commit: lint-staged not installed (run pnpm install); skipping lint, CI will still run it."
fi
exit 0
