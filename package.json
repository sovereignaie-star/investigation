{
  "name": "workspace",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "start": "node --env-file-if-exists=.env --enable-source-maps apps/server/dist/index.mjs",
    "ir": "tsx packages/cli/src/ir.ts",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./apps/**\" --filter \"./packages/**\" --filter \"./scripts\" --if-present run typecheck",
    "lint": "eslint . --max-warnings=0",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "governance": "node scripts/governance/check.mjs --last && node scripts/governance/check.mjs --consistency",
    "governance:test": "node --test scripts/governance/check.test.mjs",
    "reference:test": "node --test scripts/reference/iana-drift.test.mjs",
    "audit:measure": "node scripts/audit/measure.mjs --full",
    "gates:phase1": "scripts/node_modules/.bin/tsx scripts/gates/phase1.ts",
    "test": "vitest run",
    "e2e": "pnpm --filter @workspace/scripts e2e",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "gen:knowledge": "node scripts/gen-knowledge.mjs"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@ir/test-utils": "workspace:*",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.7",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.6",
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
