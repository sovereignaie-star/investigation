{
  "$id": "https://github.com/sovereignaie-star/investigation/schema/Identifier.schema.json",
  "title": "Identifier",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "raw": {
      "type": "string",
      "minLength": 1
    },
    "normalized": {
      "type": "string",
      "minLength": 1
    },
    "validator": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "span": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  },
  "required": ["type", "raw", "normalized", "validator", "confidence"]
}
