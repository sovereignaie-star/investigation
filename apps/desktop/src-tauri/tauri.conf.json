{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Investigations",
  "version": "0.1.0",
  "identifier": "app.investigation.desktop",
  "build": {
    "beforeBuildCommand": "pnpm --filter @ir/web build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "منصة التحقيقات المفتوحة",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
