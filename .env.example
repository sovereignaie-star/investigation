# Investigation Room — environment variables (ROADMAP appendix D). Copy to .env and fill in. Never commit .env (GR-12).
# Provider API keys do NOT belong here; they are stored in the encrypted key vault (P1-015).

# Optional. Hosts such as Render and Railway set PORT themselves.
PORT=8080              # server (single service: API + built web app)
BASE_PATH=/            # web base path
API_URL=http://localhost:8080   # web dev server proxy target for /api
WEB_DIST=              # override the built web app location served by the server

# Optional: local startup binds to 127.0.0.1; production defaults to 0.0.0.0. Docker sets this explicitly.
HOST=127.0.0.1
# Only for team deployments with Postgres (ADR-04)
DATABASE_URL=
IR_DATA_DIR=           # cases and the key vault (default ./data); mount a persistent disk here when hosted

# Key vault (P1-015). Provider API keys are stored only on the server, sealed with AES-256-GCM.
# Master key: IR_VAULT_KEY (32 bytes base64, `openssl rand -base64 32`), or IR_VAULT_PASSPHRASE (Argon2id),
# or neither on a local install (a 0600 key file is generated at IR_DATA_DIR/vault.key).
IR_VAULT_KEY=
IR_VAULT_PASSPHRASE=
# Required for every /api/vault and /api/lookup request, including local installations. Generate with:
# openssl rand -hex 32
IR_ADMIN_TOKEN=
# Number of reverse proxies in front of the server (Render/Railway: 1), so rate limits see real client addresses.
TRUST_PROXY=
IR_OFFLINE=0
IR_LOG_LEVEL=info
IR_SIM=0
